# 이 파일을 루트 .env로 복사하여 사용합니다. .env는 커밋하지 않습니다.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=cmms
DB_PASSWORD=change-me
DB_NAME=cmms
PORT=3000

# 최소 32바이트 이상의 무작위 문자열을 사용합니다.
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=1209600
AUTH_FAILED_LOGIN_LIMIT=5
AUTH_LOCK_MINUTES=30

# 루트 .env 기준 상대 경로입니다. backend/frontend에는 별도 .env를 두지 않습니다.
FILE_STORAGE_DRIVER=local
FILE_STORAGE_ROOT=./storage
FILE_MAX_SIZE_BYTES=10485760
# 쉼표(,)로 구분합니다. 업로드 요청의 MIME type과 파일 확장자를 각각 검사합니다.
FILE_ALLOWED_CONTENT_TYPES=application/pdf,image/jpeg,image/png
FILE_ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png

# frontend에서만 노출 가능한 값은 VITE_ 접두사를 사용합니다.
VITE_API_BASE_URL=/api
